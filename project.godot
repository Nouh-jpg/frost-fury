; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="Frost Fury: Chronicles of the Frostbound"
config/description="A 16-bit Sega Genesis-style arcade fantasy hybrid brawler blending Streets of Rage 3 melee combos with Snow Bros bowling mechanics for Android and Steam."
config/version="1.0.0"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.3", "4.4", "4.5", "4.6", "4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SoundManager="*res://scripts/autoload/sound_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
