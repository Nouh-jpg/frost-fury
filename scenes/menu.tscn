text = "COMBAT & SNOW BROS BOWLING GUIDE"
horizontal_alignment = 1

[node name="HelpContent" type="RichTextLabel" parent="HelpPanel/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.9, 0.95, 1, 1)
theme_override_font_sizes/normal_font_size = 9
bbcode_enabled = true
text = "[color=#ffd166]Melee Combos:[/color] Tap Attack for 3-hit combo (Jab -> Cross -> Ice Geyser Uppercut).
[color=#ffd166]Blitz Rush:[/color] Hold Blitz / Shift + Attack to lunge forward with ice fists.
[color=#00f5ff]Snow Bros Mechanic:[/color] Punching enemies encases them in a [b]Frost Sphere[/b]!
Walk up to a Frost Sphere and press [b]Attack to Kick it[/b]! The sphere rolls, bounces off walls, and bowls down entire waves of enemies for massive multi-kill points and loot drops!
[color=#ffd166]Controls:[/color]
• PC Keyboard: [b]A/D[/b] = Move, [b]J[/b] = Attack/Kick, [b]K/Space[/b] = Jump, [b]L[/b] = Blitz, [b]I[/b] = Special
• Gamepad / Steam Deck: [b]D-Pad[/b] = Move, [b]X[/b] = Attack, [b]A[/b] = Jump, [b]RB/Y[/b] = Blitz
• Android: Virtual Touch D-pad & Arcade Buttons [A] [B] [X] [Y]"

